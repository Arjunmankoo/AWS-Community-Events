APP_ENV=local
SECRET_KEY=replace-with-a-random-value
ADMIN_PASSWORD_HASH=replace-with-generated-password-hash
DATABASE_URL=sqlite
STORAGE_BACKEND=local
# For AWS deployment, set APP_ENV=production, DATABASE_URL=mysql, STORAGE_BACKEND=s3
AWS_REGION=eu-west-2
S3_BUCKET=your-unique-private-bucket-name
RDS_HOST=your-rds-endpoint
RDS_PORT=3306
RDS_DATABASE=events
RDS_USER=events_app
RDS_PASSWORD=replace-on-server-only
RDS_SSL_CA=/etc/ssl/certs/global-bundle.pem
