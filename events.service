[Unit]
Description=Community Events web application
After=network-online.target
Wants=network-online.target

[Service]
User=events
Group=events
WorkingDirectory=/opt/aws-events
EnvironmentFile=/etc/aws-events.env
ExecStart=/opt/aws-events/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8000 --access-logfile - --error-logfile - "app:create_app()"
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/aws-events

[Install]
WantedBy=multi-user.target
